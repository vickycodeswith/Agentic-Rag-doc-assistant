# ==============================================================================
# Express Analytics RAG Assistant Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: 'gemini' (default, free tier), 'groq' (free tier), 'openai'
LLM_PROVIDER=gemini

# Provider API Keys (Set the one matching your LLM_PROVIDER)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Specific Model Overrides (Optional - sensible defaults are provided)
# Gemini default: gemini-1.5-flash
# Groq default: llama-3.3-70b-versatile
# OpenAI default: gpt-4o-mini
LLM_MODEL_NAME=

# Embedding Configuration
# Providers: 'google' (default with gemini), 'openai', 'huggingface' (local zero-cost)
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL_NAME=models/text-embedding-004

# Vector Store Settings
CHROMA_PERSIST_DIRECTORY=data/chroma_db
CHROMA_COLLECTION_NAME=technical_documentation

# RAG & Graph Parameters
RETRIEVAL_TOP_K=4
MAX_RETRIES=2
CONFIDENCE_THRESHOLD=0.6
ENABLE_HALLUCINATION_CHECK=true
ENABLE_WEB_SEARCH_FALLBACK=true

# Web Search API Keys (Optional)
# If TAVILY_API_KEY is not provided, the system seamlessly uses DuckDuckGo (zero-cost)
TAVILY_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
